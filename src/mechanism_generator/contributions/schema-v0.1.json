    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pseudonym": {
          "type": "string",
          "maxLength": 100
        },
        "application": {
          "type": "string",
          "maxLength": 4000
        }
      },
      "required": [
        "pseudonym",
        "application"
      ]
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terms_version": {
          "const": "1"
        },
        "license": {
          "const": "Apache-2.0"
        },
        "rights_confirmed": {
          "const": true
        },
        "public_sharing_and_training": {
          "const": true
        }
      },
      "required": [
        "terms_version",
        "license",
        "rights_confirmed",
        "public_sharing_and_training"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "core"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "submission"
          }
        }
      },
      "then": {
        "required": [
          "contributor",
          "consent"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "contributor"
              ]
            },
            {
              "required": [
                "consent"
              ]
            }
          ]
        }
      }
    }
  ]
}
