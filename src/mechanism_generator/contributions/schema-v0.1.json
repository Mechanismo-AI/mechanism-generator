{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mechanismo-AI/mechanism-generator/blob/main/src/mechanism_generator/contributions/schema.json",
  "title": "Mechanism Generator community contribution 0.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "kind": {
      "enum": [
        "local",
        "submission"
      ]
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "generator_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+[a-z0-9.]*$"
        },
        "engine": {
          "const": "r2.5c"
        },
        "run_status": {
          "enum": [
            "completed",
            "partial",
            "unknown"
          ]
        },
        "validation_status": {
          "const": "unreviewed"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^task-[0-9]{4,}$"
              },
              "candidate_count": {
                "type": "integer",
                "minimum": 0
              },
              "path_acceptable_count": {
                "type": "integer",
                "minimum": 0
              },
              "selection_eligible_count": {
                "type": "integer",
                "minimum": 0
              },
              "engineering_acceptable_count": {
                "type": "integer",
                "minimum": 0
              },
              "selected_count": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "task_id",
              "candidate_count",
              "path_acceptable_count",
              "selection_eligible_count",
              "engineering_acceptable_count",
              "selected_count"
            ]
          }
        }
      },
      "required": [
        "generator_version",
        "engine",
        "run_status",
        "validation_status",
        "tasks"
      ]
    },
    "task": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task-[0-9]{4,}$"
          },
          "target_values": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 6,
            "maxItems": 6
          }
        },
        "required": [
          "task_id",
          "target_values"
        ]
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^task-[0-9]{4,}$"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "S_ratio": {
                  "type": "number"
                },
                "absolute_mean_error_acceptable": {
                  "type": "boolean"
                },
                "absolute_point_errors_acceptable": {
                  "type": "boolean"
                },
                "accuracy_score": {
                  "type": "number"
                },
                "acquired_error_1": {
                  "type": "number"
                },
                "acquired_error_2": {
                  "type": "number"
                },
                "acquired_error_3": {
                  "type": "number"
                },
                "acquired_mean_error": {
                  "type": "number"
                },
                "assembly_margin_ratio": {
                  "type": "number"
                },
                "balanced_score": {
                  "type": "number"
                },
                "bar_length": {
                  "type": "number"
                },
                "bar_length_ratio": {
                  "type": "number"
                },
                "base_angle": {
                  "type": "number"
                },
                "base_x": {
                  "type": "number"
                },
                "base_y": {
                  "type": "number"
                },
                "branch_sign": {
                  "type": "number"
                },
                "checkpoint_epoch": {
                  "type": "number"
                },
                "compactness_acceptable": {
                  "type": "boolean"
                },
                "compactness_penalty": {
                  "type": "number"
                },
                "compactness_score": {
                  "type": "number"
                },
                "crank_margin_min": {
                  "type": "number"
                },
                "crank_margin_ratio": {
                  "type": "number"
                },
                "engineering_acceptable": {
                  "type": "boolean"
                },
                "error_1": {
                  "type": "number"
                },
                "error_2": {
                  "type": "number"
                },
                "error_3": {
                  "type": "number"
                },
                "exact_mechanism_class": {
                  "type": "boolean"
                },
                "follower_margin": {
                  "type": "number"
                },
                "follower_margin_ratio": {
                  "type": "number"
                },
                "follower_not_longest_enforced": {
                  "type": "boolean"
                },
                "full_cycle_assembly": {
                  "type": "boolean"
                },
                "full_cycle_assembly_violation": {
                  "type": "number"
                },
                "global_angle_mean_deg": {
                  "type": "number"
                },
                "global_angle_min_deg": {
                  "type": "number"
                },
                "global_angle_softmin_deg": {
                  "type": "number"
                },
                "global_below_floor_fraction": {
                  "type": "number"
                },
                "global_below_target_fraction": {
                  "type": "number"
                },
                "global_selection_floor_acceptable": {
                  "type": "boolean"
                },
                "global_transmission_acceptable": {
                  "type": "boolean"
                },
                "global_transmission_min_penalty": {
                  "type": "number"
                },
                "global_transmission_penalty": {
                  "type": "number"
                },
                "global_transmission_top_penalty": {
                  "type": "number"
                },
                "grashof_margin": {
                  "type": "number"
                },
                "grashof_margin_ratio": {
                  "type": "number"
                },
                "grashof_ok": {
                  "type": "boolean"
                },
                "grashof_violation": {
                  "type": "number"
                },
                "initial_full_cycle_assembly": {
                  "type": "boolean"
                },
                "initial_global_angle_min_deg": {
                  "type": "number"
                },
                "initial_max_error": {
                  "type": "number"
                },
                "initial_mean_error": {
                  "type": "number"
                },
                "initial_target_angle_min_deg": {
                  "type": "number"
                },
                "l1": {
                  "type": "number"
                },
                "l2": {
                  "type": "number"
                },
                "l3": {
                  "type": "number"
                },
                "l4": {
                  "type": "number"
                },
                "local_path_budget_feasible": {
                  "type": "boolean"
                },
                "max_error": {
                  "type": "number"
                },
                "max_error_improvement": {
                  "type": "number"
                },
                "max_link_ratio": {
                  "type": "number"
                },
                "mean_error": {
                  "type": "number"
                },
                "mean_error_improvement": {
                  "type": "number"
                },
                "mean_path_budget": {
                  "type": "number"
                },
                "path_acceptable": {
                  "type": "boolean"
                },
                "path_area_ratio": {
                  "type": "number"
                },
                "path_budget_feasible": {
                  "type": "boolean"
                },
                "perturbation_index": {
                  "type": "number"
                },
                "phase_1_deg": {
                  "type": "number"
                },
                "phase_1_rad": {
                  "type": "number"
                },
                "phase_2_deg": {
                  "type": "number"
                },
                "phase_2_rad": {
                  "type": "number"
                },
                "phase_3_deg": {
                  "type": "number"
                },
                "phase_3_rad": {
                  "type": "number"
                },
                "physical_feasible": {
                  "type": "boolean"
                },
                "point_budget_1": {
                  "type": "number"
                },
                "point_budget_2": {
                  "type": "number"
                },
                "point_budget_3": {
                  "type": "number"
                },
                "profile_score": {
                  "type": "number"
                },
                "robustness_acceptable": {
                  "type": "boolean"
                },
                "robustness_penalty": {
                  "type": "number"
                },
                "sampled_assembly_success": {
                  "type": "number"
                },
                "selected_rank": {
                  "type": "number"
                },
                "selection_eligible": {
                  "type": "boolean"
                },
                "shared_mean_path_budget": {
                  "type": "number"
                },
                "shared_path_budget_feasible": {
                  "type": "boolean"
                },
                "shared_path_reference_error_1": {
                  "type": "number"
                },
                "shared_path_reference_error_2": {
                  "type": "number"
                },
                "shared_path_reference_error_3": {
                  "type": "number"
                },
                "shared_path_reference_mean_error": {
                  "type": "number"
                },
                "shared_point_budget_1": {
                  "type": "number"
                },
                "shared_point_budget_2": {
                  "type": "number"
                },
                "shared_point_budget_3": {
                  "type": "number"
                },
                "sweep_area_ratio": {
                  "type": "number"
                },
                "sweep_diagonal_ratio": {
                  "type": "number"
                },
                "sweep_height_ratio": {
                  "type": "number"
                },
                "sweep_radius_ratio": {
                  "type": "number"
                },
                "sweep_width_ratio": {
                  "type": "number"
                },
                "target_angle_1_deg": {
                  "type": "number"
