                "target_angle_2_deg": {
                  "type": "number"
                },
                "target_angle_3_deg": {
                  "type": "number"
                },
                "target_angle_mean_deg": {
                  "type": "number"
                },
                "target_angle_min_change_deg": {
                  "type": "number"
                },
                "target_angle_min_deg": {
                  "type": "number"
                },
                "target_angle_softmin_deg": {
                  "type": "number"
                },
                "target_centroid_x": {
                  "type": "number"
                },
                "target_centroid_y": {
                  "type": "number"
                },
                "target_scale": {
                  "type": "number"
                },
                "target_selection_floor_acceptable": {
                  "type": "boolean"
                },
                "target_transmission_acceptable": {
                  "type": "boolean"
                },
                "target_transmission_mean_penalty": {
                  "type": "number"
                },
                "target_transmission_penalty": {
                  "type": "number"
                },
                "target_transmission_worst_penalty": {
                  "type": "number"
                },
                "total_link_ratio": {
                  "type": "number"
                },
                "transmission_score": {
                  "type": "number"
                },
                "candidate_id": {
                  "type": "string",
                  "pattern": "^candidate-[0-9]{4,}$"
                },
                "portfolio_parent_candidate_id": {
                  "type": "string",
                  "pattern": "^candidate-[0-9]{4,}$"
                },
                "shared_path_reference_candidate_id": {
                  "type": "string",
                  "pattern": "^candidate-[0-9]{4,}$"
                },
                "model_role": {
                  "enum": [
                    "balanced",
                    "path",
                    "transmission"
                  ]
                },
                "profile": {
                  "enum": [
                    "accuracy",
                    "balanced",
                    "transmission"
                  ]
                },
                "portfolio_origin": {
                  "enum": [
                    "fixed",
                    "variable",
                    "bridge_trust",
                    "bridge_release"
                  ]
                },
                "ground_link_mode": {
                  "enum": [
                    "fixed",
                    "optimize"
                  ]
                },
                "qualification_level": {
                  "enum": [
                    "not_physical",
                    "physical_only_path_rejected",
                    "path_acceptable_but_robustness_failed",
                    "path_acceptable_but_compactness_failed",
                    "path_acceptable_but_selection_floor_failed",
                    "selection_acceptable",
                    "engineering_acceptable",
                    "not_evaluated"
                  ]
                }
              },
              "required": [
                "candidate_id"
              ]
            }
          }
        },
        "required": [
          "task_id",
          "items"
        ]
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parent_engine_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "enum": [
                  "balanced",
                  "path",
                  "transmission"
                ]
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "role",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "models"
      ]
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_roles": {
          "type": "array",
          "items": {
            "enum": [
              "balanced",
              "path",
              "transmission"
            ]
          },
          "uniqueItems": true
        },
        "profile_matrix": {
          "enum": [
            "paired",
            "cross"
          ]
        },
        "branches": {
          "enum": [
            "negative",
            "positive",
            "both"
          ]
        },
        "phase_mode": {
          "enum": [
            "unordered",
            "ordered"
          ]
        },
        "perturbations_per_model": {
          "type": "integer"
        },
        "parameter_noise": {
          "type": "number"
        },
        "phase_noise_deg": {
          "type": "number"
        },
        "ground_link_mode": {
          "enum": [
            "optimize",
            "fixed"
          ]
        },
        "fixed_ground_link_value": {
          "type": "number"
        },
        "ground_link_min_ratio": {
          "type": "number"
        },
        "ground_link_max_ratio": {
          "type": "number"
        },
        "moving_link_min_ratio": {
          "type": "number"
        },
        "moving_link_max_ratio": {
          "type": "number"
        },
        "bar_length_max_ratio": {
          "type": "number"
        },
        "base_search_radius_ratio": {
          "type": "number"
        },
        "minimum_target_scale": {
          "type": "number"
        },
        "adam_accuracy_steps": {
          "type": "integer"
        },
        "adam_tradeoff_steps": {
          "type": "integer"
        },
        "adam_lr": {
          "type": "number"
        },
        "lbfgs_steps": {
          "type": "integer"
        },
        "lbfgs_lr": {
          "type": "number"
        },
        "grad_clip": {
          "type": "number"
        },
        "seed_phase_steps": {
          "type": "integer"
        },
        "optimization_global_steps": {
          "type": "integer"
        },
        "verification_steps": {
          "type": "integer"
        },
        "target_transmission_deg": {
          "type": "number"
        },
        "global_transmission_floor_deg": {
          "type": "number"
        },
        "worst_target_focus": {
          "type": "number"
        },
        "worst_target_temperature": {
          "type": "number"
        },
        "global_min_focus": {
